# voice_hub device client — copy to ~/.config/voice_hub/client.env
# No cloud API keys. Host keys stay on the computer running run_server.sh.

VOICE_HUB_URL=ws://10.101.67.111:8765
ROBOT_ID=tianlian_dual
ROBOT_SCHEMA_VERSION=1

# Demo vs live. 0 = dry_run (default). 1 = really publish / massage.
# Need a person on site and e-stop ready before setting either to 1.
VOICE_ENABLE_ROBOT_COMMAND=0
VOICE_ENABLE_MASSAGE=0
# APLAY_DEVICE=default
# ARECORD_DEVICE=default

# Directory that contains the tianlian_voice_bridge Python package (on this device).
# VOICE_HUB_BRIDGE_PATH=$HOME/tianlian_voice_bridge

# Wake word (device-side sherpa-onnx KWS). Do not copy host cloud keys.
# WAKE_WORD=小溪小溪
# VOICE_KWS_MODEL_DIR=/home/li/VoiceOnline/models/sherpa-onnx-kws-zipformer-zh-en-3M-2025-12-20
# Optional: extra site-packages if sherpa-onnx lives in another venv.
# VOICE_KWS_PYTHONPATH=/home/li/VoiceOnline/.venv_online/lib/python3.10/site-packages
# ARECORD_DEVICE=default

# Speaker gate. off = anyone after wake. shadow = log only. enforce = reject others.
# Default off. Do not turn on enforce until a profile is enrolled.
VOICE_SPEAKER_VERIFY_MODE=off
# VOICE_SPEAKER_THRESHOLD=0.60
# VOICE_SPEAKER_MIN_SPEECH_MS=1000
# VOICE_SPEAKER_PROFILE_DIR=$HOME/VoiceOnline/runtime_data/speaker_profiles
# VOICE_SPEAKER_MODEL_PATH=$HOME/VoiceOnline/models/speaker/3dspeaker_speech_campplus_sv_zh-cn_16k-common.onnx
# VOICE_ONLINE_ROOT=$HOME/VoiceOnline
