# Copy to /home/ning/model/voice_hub/.env (mode 600), or to /etc/voice_hub.env if you have sudo.
# Do not commit keys. run_server.sh loads /etc/voice_hub.env first, then the project .env.

VOICE_HUB_HOST=0.0.0.0
VOICE_HUB_PORT=8765

# --- LLM: 阿里云百炼 Qwen（仅当端到端实时语音不可用时的闲聊备用）---
# 天气/搜索不走百炼。对话走 DIALOG（豆包端到端）时可以不填。
# Key: https://bailian.console.aliyun.com/?tab=model#/api-key  （sk- 开头）
CHAT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_LLM_API_KEY=
CHAT_LLM_MODEL=
# 模型自己填，例如 qwen-flash / qwen3.5-flash
# 智谱备选：CHAT_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#            CHAT_LLM_MODEL=glm-4.7-flash
CHAT_LLM_TIMEOUT_SEC=30
CHAT_LLM_MAX_TOKENS=256

# --- ASR: 豆包流式识别（火山，文档 6561/2630027）---
# Key 可空：空则复用 DOUBAO_TTS_API_KEY。资源 ID 不要填 TTS 的 seed-tts-*。
ASR_PROVIDER=doubao
DOUBAO_ASR_API_KEY=
DOUBAO_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
DOUBAO_ASR_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
# 回退本机 Paraformer：ASR_PROVIDER=sherpa_local
ASR_MODEL_DIR=/home/ning/model/lyz/src/voice_control_online/models/sherpa-onnx-paraformer-zh-2023-09-14

# --- TTS: 豆包语音（火山引擎）---
# 文档: https://docs.volcengine.com/docs/6561/2532486
TTS_PROVIDER=doubao
TTS_SAMPLE_RATE=16000
# 新控制台填 API Key；旧控制台填 AppID + Access Token
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_APPID=
DOUBAO_TTS_ACCESS_TOKEN=
# seed-tts-1.0 或 seed-tts-2.0，和音色版本一致
DOUBAO_TTS_RESOURCE_ID=seed-tts-1.0
# 音色 ID，自己在控制台选，例如 zh_female_shuangkuaisisi_moon_bigtts
DOUBAO_TTS_VOICE=
# 回退本机 Kokoro：TTS_PROVIDER=local
# TTS_MODEL_DIR=/home/ning/model/lyz/src/voice_control_online/models/tts/kokoro-multi-lang-v1_0

# --- 端到端实时语音（豆包 dialog，文档 6561/2549778）---
# 闲聊走这一条（听+想+说一条 WebSocket）。机械臂/知识库仍走本地规则。
# 可不填：默认复用上面的 DOUBAO_TTS_API_KEY（新控制台）或 APPID+TOKEN。
# 控制台需开通「豆包端到端实时语音」，资源 ID 不要填 seed-tts / seedasr。
# DIALOG_PROVIDER=doubao
# DIALOG_API_KEY=
# DIALOG_APPID=
# DIALOG_ACCESS_TOKEN=
# DIALOG_RESOURCE_ID=volc.speech.dialog
# DIALOG_SPEAKER=zh_male_yunzhou_jupiter_bigtts
# DIALOG_TTS_SAMPLE_RATE=16000
# 关闭：DIALOG_PROVIDER=off

# --- web search: 秘塔（推荐）---
# Key: https://metaso.cn/search-api/api-keys  （mk- 开头）
WEB_SEARCH_PROVIDER=metaso
METASO_API_KEY=
# Clash fake-ip 把 metaso.cn 解析到 198.18.x 时，若 HTTPS 失败：把该域名设为直连，
# 或 export HTTPS_PROXY=http://127.0.0.1:7890
# 自检：python3 scripts/check_search.py   （加 --live 才会真正搜一次）
# 备选 Tavily：WEB_SEARCH_PROVIDER=tavily 并填 TAVILY_API_KEY=

# --- Jetson client ---
# VOICE_HUB_URL=ws://<电脑局域网IP>:8765
# ROBOT_ID=tianlian_dual
# ROBOT_SCHEMA_VERSION=1
# ROBOT_BRIDGE_MODULE=tianlian_voice_bridge
# VOICE_ENABLE_ROBOT_COMMAND=0
